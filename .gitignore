# Omarchy and local editor backups
*.bak.*
*.swp
*.swo
*~

# OS/editor noise
.DS_Store

# Herdr runtime state (the directory itself remains managed).
/config/herdr/*.log
/config/herdr/*.sock
/config/herdr/session.json
/config/herdr/release-notes.json
/config/herdr/.plugins.lock

# Herdr-generated OpenCode integration (reinstalled by herdr).
/config/opencode/cli.json
/config/opencode/tui.jsonc
/config/opencode/herdr-opencode/
/config/opencode/herdr-tui-session.js
/config/opencode/plugins/herdr-agent-state.js

# Runtime credentials.
/config/opencode/service.json

# Plugin-managed Hyprland shortcuts (regenerated by their apps).
/config/hypr/omaview.lua
/config/hypr/openwhispr-binds.lua
